<?xml version="1.0" encoding="UTF-8"?>

<Patch MayRequire="Ludeon.RimWorld.Odyssey">
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Odyssey</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>
                <!-- Grassland Soil -->
                <li Class="PatchOperationReplace">
                    <xpath>/Defs/TerrainDef[defName="GrasslandSoil"]/fertility</xpath>
                    <value>
                        <fertility>0.7</fertility>
                    </value>
                </li>

                <li Class="PatchOperationAdd">
                    <xpath>/Defs/TerrainDef[defName="GrasslandSoil"]</xpath>
                    <value>
                        <modExtensions>
                            <li Class="AdvancedCultivation.TerrainExtension">
                                <tillsTo>AC_GrasslandSoilTilled</tillsTo>
                            </li>
                        </modExtensions>
                    </value>
                </li>

                <!-- Glowforest Soil -->
                <li Class="PatchOperationReplace">
                    <xpath>/Defs/TerrainDef[defName="GlowforestSoil"]/fertility</xpath>
                    <value>
                        <fertility>0.7</fertility>
                    </value>
                </li>

                <li Class="PatchOperationAdd">
                    <xpath>/Defs/TerrainDef[defName="GlowforestSoil"]</xpath>
                    <value>
                        <modExtensions>
                            <li Class="AdvancedCultivation.TerrainExtension">
                                <tillsTo>AC_GlowforestSoilTilled</tillsTo>
                            </li>
                        </modExtensions>
                    </value>
                </li>
            </operations>
        </match>
    </Operation>
</Patch>